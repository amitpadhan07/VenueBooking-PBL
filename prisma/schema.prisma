generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
  EMPLOYEE
}

enum VenueStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum AuthorityStatus {
  ACTIVE
  REVOKED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

model User {
  user_id       String   @id @default(uuid()) @map("user_id")
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password_hash String   @map("password_hash")
  role          Role
  department    String   @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @default(now()) @updatedAt @map("updated_at")

  employee            Employee?
  assigned_authorities VenueAuthority[] @relation("AssignedBy")
  bookings            Booking[]
  notifications       Notification[]
  audit_logs          AuditLog[]

  @@map("users")
}

model Venue {
  venue_id    String      @id @default(uuid()) @map("venue_id")
  venue_name  String      @unique @map("venue_name") @db.VarChar(100)
  location    String      @db.VarChar(200)
  capacity    Int
  venue_type  String      @map("venue_type") @db.VarChar(50)
  description String?     @db.Text
  status      VenueStatus @default(ACTIVE)
  created_at  DateTime    @default(now()) @map("created_at")
  updated_at  DateTime    @default(now()) @updatedAt @map("updated_at")

  authorities VenueAuthority[]
  bookings    Booking[]

  @@map("venues")
}

model Employee {
  employee_id   String   @id @default(uuid()) @map("employee_id")
  user_id       String   @unique @map("user_id")
  employee_code String   @unique @map("employee_code") @db.VarChar(50)
  designation   String   @db.VarChar(100)
  department    String   @db.VarChar(100)
  status        String   @default("ACTIVE") @db.VarChar(20)
  created_at    DateTime @default(now()) @map("created_at")

  user        User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  authorities VenueAuthority[]
  approvals   Approval[]

  @@map("employees")
}

model VenueAuthority {
  authority_id String          @id @default(uuid()) @map("authority_id")
  employee_id  String          @map("employee_id")
  venue_id     String          @map("venue_id")
  assigned_by  String          @map("assigned_by")
  assigned_at  DateTime        @default(now()) @map("assigned_at")
  status       AuthorityStatus @default(ACTIVE)

  employee Employee @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)
  venue    Venue    @relation(fields: [venue_id], references: [venue_id], onDelete: Cascade)
  assigner User     @relation("AssignedBy", fields: [assigned_by], references: [user_id], onDelete: Cascade)

  @@unique([employee_id, venue_id])
  @@index([employee_id, venue_id, status], map: "idx_venue_authority")
  @@map("venue_authority")
}

model Booking {
  booking_id         String        @id @default(uuid()) @map("booking_id")
  user_id            String        @map("user_id")
  venue_id           String        @map("venue_id")
  event_name         String        @map("event_name") @db.VarChar(150)
  event_description  String?       @map("event_description") @db.Text
  event_date         DateTime      @map("event_date") @db.Date
  start_time         String        @map("start_time") @db.VarChar(10)
  end_time           String        @map("end_time") @db.VarChar(10)
  expected_attendees Int           @map("expected_attendees")
  status             BookingStatus @default(PENDING)
  created_at         DateTime      @default(now()) @map("created_at")
  updated_at         DateTime      @default(now()) @updatedAt @map("updated_at")

  user          User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  venue         Venue          @relation(fields: [venue_id], references: [venue_id], onDelete: Cascade)
  approvals     Approval[]
  notifications Notification[]

  @@index([venue_id, event_date, status, start_time, end_time], map: "idx_bookings_lookup")
  @@index([user_id, status], map: "idx_user_bookings")
  @@map("bookings")
}

model Approval {
  approval_id String         @id @default(uuid()) @map("approval_id")
  booking_id  String         @map("booking_id")
  employee_id String         @map("employee_id")
  action      ApprovalAction
  remarks     String?        @db.Text
  action_at   DateTime       @default(now()) @map("action_at")

  booking  Booking  @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)

  @@index([booking_id], map: "idx_approvals_booking")
  @@map("approvals")
}

model Notification {
  notification_id   String   @id @default(uuid()) @map("notification_id")
  user_id           String   @map("user_id")
  booking_id        String?  @map("booking_id")
  title             String   @db.VarChar(150)
  message           String   @db.Text
  notification_type String   @map("notification_type") @db.VarChar(50)
  is_read           Boolean  @default(false) @map("is_read")
  created_at        DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  booking Booking? @relation(fields: [booking_id], references: [booking_id], onDelete: SetNull)

  @@index([user_id, is_read], map: "idx_notifications_user")
  @@map("notifications")
}

model AuditLog {
  log_id      String   @id @default(uuid()) @map("log_id")
  user_id     String?  @map("user_id")
  action      String   @db.VarChar(100)
  entity_type String   @map("entity_type") @db.VarChar(50)
  entity_id   String   @map("entity_id") @db.VarChar(100)
  details     String?  @db.Text
  created_at  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@map("audit_logs")
}
